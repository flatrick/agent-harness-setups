{
  "defaultShell": "powershell",
  "showThinkingSummaries": true,
  "showTurnDuration": true,
  "worktree.baseRef": "head",
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(git rev-parse --show-toplevel)/.claude/hooks/worktree-create.ps1\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$(git rev-parse --show-toplevel)/.claude/hooks/worktree-remove.ps1\""
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash C:/Users/PatrikMattsson/.claude/statusline-command.sh"
  },
  "verbose": true,
  "preferredNotifChannel": "auto"
}
